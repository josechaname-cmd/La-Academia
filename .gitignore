# Only application source, safe documentation and reproducible tooling belong here.
/*
!/.gitignore
!/.gitattributes
!/.htaccess
!/README.md
!/SECURITY.md
!/backend/
!/public/
!/tools/
!/tests/
!/docs/
!/storage/

# Private configuration, uploads, personnel, results, logs, sessions and backups.
/storage/*
!/storage/.htaccess
!/storage/config.example.php
/archive/
/assets/
.env
.env.*
!.env.example
*.local.php
*.local.json
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
*.log
*.dump
*.bak
*.zip
*.7z
*.tar*
*.sql
!/backend/database/schema.sql
!/docs/multisede/propuesta-esquema.sql
*.csv
*.tsv
*.xls
*.xlsx
*.doc
*.docx
*.ppt
*.pptx
*.pdf
*.mp4
*.webm
*.mov
*.avi
*.mkv

# Local evidence and original operational imagery are not source code.
/docs/screenshots/
/docs/auditoria-backend/
/public/assets/slider/*
!/public/assets/slider/.gitkeep
!/public/assets/slider/LEEME.txt

# Install these dependencies locally; do not publish binaries or caches.
/tools/runtime/
**/node_modules/
**/__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/
